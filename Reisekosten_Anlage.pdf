/JS (function SYS_CHECK_MF_FIELDS\(\)\r{\r        var n = this.numFields;\r        var f;\r        var fn;\r        for\(var i=0;i<n;i++\)\r        {\r                fn = this.getNthFieldName\(i\);\r                if\( \(""!=fn\) && \("SYSTEM_P1_DUMMY"!=fn\) \)\r                {\r                        f = this.getField\(fn\);\r                        if\( \(null!=f\) && \("button"!=f.type\) \)\r                        {\r                                if\(\(f.required\)&&\(""==f.value\)\)\r                                {\r                                        return false;\r                                }\r                        }\r                }\r        }\r    	if\(true==SYS_CB_HDL_Nutzung_Befoerderungsmittel\(false\)\){return false;}\r    	if\(true==SYS_CB_HDL_Oepnv_Parken\(false\)\){return false;}\r    	if\(true==SYS_CB_HDL_Nutzung_Befoerderungsmittel1\(false\)\){return false;}\r    	if\(true==SYS_CB_HDL_Oepnv_Parken1\(false\)\){return false;}\r    	if\(true==SYS_CB_HDL_Nutzung_Befoerderungsmittel2\(false\)\){return false;}\r    	if\(true==SYS_CB_HDL_Oepnv_Parken2\(false\)\){return false;}\r    	if\(true==SYS_CB_HDL_Nutzung_Befoerderungsmittel3\(false\)\){return false;}\r    	if\(true==SYS_CB_HDL_Oepnv_Parken3\(false\)\){return false;}\r    	if\(true==SYS_CB_HDL_Nutzung_Befoerderungsmittel4\(false\)\){return false;}\r    	if\(true==SYS_CB_HDL_Oepnv_Parken4\(false\)\){return false;}\r    	if\(true==SYS_CB_HDL_Nutzung_Befoerderungsmittel5\(false\)\){return false;}\r    	if\(true==SYS_CB_HDL_Oepnv_Parken5\(false\)\){return false;}\r    	if\(true==SYS_CB_HDL_Nutzung_Befoerderungsmittel6\(false\)\){return false;}\r    	if\(true==SYS_CB_HDL_Oepnv_Parken6\(false\)\){return false;}\r    	if\(true==SYS_CB_HDL_Nutzung_Befoerderungsmittel7\(false\)\){return false;}\r    	if\(true==SYS_CB_HDL_Oepnv_Parken7\(false\)\){return false;}\r    	if\(true==SYS_CB_HDL_Nutzung_Befoerderungsmittel8\(false\)\){return false;}\r    	if\(true==SYS_CB_HDL_Oepnv_Parken8\(false\)\){return false;}\r    	if\(true==SYS_CB_HDL_Nutzung_Befoerderungsmittel9\(false\)\){return false;}\r    	if\(true==SYS_CB_HDL_Oepnv_Parken9\(false\)\){return false;}\r    	if\(true==SYS_CB_HDL_Nutzung_Befoerderungsmittel10\(false\)\){return false;}\r    	if\(true==SYS_CB_HDL_Oepnv_Parken10\(false\)\){return false;}\r    	if\(true==SYS_CB_HDL_Nutzung_Befoerderungsmittel11\(false\)\){return false;}\r    	if\(true==SYS_CB_HDL_Oepnv_Parken11\(false\)\){return false;}\r    	if\(true==SYS_CB_HDL_Nutzung_Befoerderungsmittel12\(false\)\){return false;}\r    	if\(true==SYS_CB_HDL_Oepnv_Parken12\(false\)\){return false;}\r    	if\(true==SYS_CB_HDL_Nutzung_Befoerderungsmittel13\(false\)\){return false;}\r    	if\(true==SYS_CB_HDL_Oepnv_Parken13\(false\)\){return false;}\r    	if\(true==SYS_CB_HDL_Nutzung_Befoerderungsmittel14\(false\)\){return false;}\r    	if\(true==SYS_CB_HDL_Oepnv_Parken14\(false\)\){return false;}\r        return true;\r}\r)
