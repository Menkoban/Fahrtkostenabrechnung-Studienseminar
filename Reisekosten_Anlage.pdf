/JS (function SYS_RESET_BG_COLORS_UPON_ALL_PAGES\(\)\r{\rSYS_PA2_SUBMIT\(\);\r        var n = this.numFields;\r        var f;\r        var fn;\r        for\(var i=0;i<n;i++\)\r        {\r                fn = this.getNthFieldName\(i\);\r                if\( \(""!=fn\) && \("SYSTEM_P1_DUMMY"!=fn\) \)\r                {\r                        f = this.getField\(fn\);\r                        if\( \(null!=f\) && \("button"!=f.type\) \)\r                        {\r                                if\("checkbox"==f.type\)\r                                { \r                                  f.style=style.cr;\r                                }\r                                if\(f.readonly\)\r                                {\r                                        if\(f.readonly\) SYS_FILL\(f,["RGB",0.749,0.749,0.749]\);\r                                }\r                                else\r                                {\r                                     SYS_FILL\(f,getBgColor\(fn\)\);\r                                }\r                                if\(\(f.required\)&&\(""==f.value\)\)\r                                {\r                                        f.strokeColor=color.red;\r                                }\r                                else\r                                {\r                                   f.strokeColor=getBorderColor\(fn\);\r                                }\r                        }\r                }\r        }\r    	SYS_CB_HDL_Nutzung_Befoerderungsmittel\(true\);\r    	SYS_CB_HDL_Oepnv_Parken\(true\);\r    	SYS_CB_HDL_Nutzung_Befoerderungsmittel1\(true\);\r    	SYS_CB_HDL_Oepnv_Parken1\(true\);\r    	SYS_CB_HDL_Nutzung_Befoerderungsmittel2\(true\);\r    	SYS_CB_HDL_Oepnv_Parken2\(true\);\r    	SYS_CB_HDL_Nutzung_Befoerderungsmittel3\(true\);\r    	SYS_CB_HDL_Oepnv_Parken3\(true\);\r    	SYS_CB_HDL_Nutzung_Befoerderungsmittel4\(true\);\r    	SYS_CB_HDL_Oepnv_Parken4\(true\);\r    	SYS_CB_HDL_Nutzung_Befoerderungsmittel5\(true\);\r    	SYS_CB_HDL_Oepnv_Parken5\(true\);\r    	SYS_CB_HDL_Nutzung_Befoerderungsmittel6\(true\);\r    	SYS_CB_HDL_Oepnv_Parken6\(true\);\r    	SYS_CB_HDL_Nutzung_Befoerderungsmittel7\(true\);\r    	SYS_CB_HDL_Oepnv_Parken7\(true\);\r    	SYS_CB_HDL_Nutzung_Befoerderungsmittel8\(true\);\r    	SYS_CB_HDL_Oepnv_Parken8\(true\);\r    	SYS_CB_HDL_Nutzung_Befoerderungsmittel9\(true\);\r    	SYS_CB_HDL_Oepnv_Parken9\(true\);\r    	SYS_CB_HDL_Nutzung_Befoerderungsmittel10\(true\);\r    	SYS_CB_HDL_Oepnv_Parken10\(true\);\r    	SYS_CB_HDL_Nutzung_Befoerderungsmittel11\(true\);\r    	SYS_CB_HDL_Oepnv_Parken11\(true\);\r    	SYS_CB_HDL_Nutzung_Befoerderungsmittel12\(true\);\r    	SYS_CB_HDL_Oepnv_Parken12\(true\);\r    	SYS_CB_HDL_Nutzung_Befoerderungsmittel13\(true\);\r    	SYS_CB_HDL_Oepnv_Parken13\(true\);\r    	SYS_CB_HDL_Nutzung_Befoerderungsmittel14\(true\);\r    	SYS_CB_HDL_Oepnv_Parken14\(true\);\r}\r)
