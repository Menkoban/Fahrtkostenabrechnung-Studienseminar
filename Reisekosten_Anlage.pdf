/Rect [ 669.7 287.46 695.87 296.56 ]
/F 4
/P 4 0 R
/T (Grund_Nutzung_Pkw7)
/Ff 12582912
/FT /Tx 
/Q 1
/DA (/Cour 8.0 Tf 0 g)
/DV ()
/V ()
/TU (Gegebenfalls Grund für die Nutzung des PKW \(G1-G5\) *)
/AP << /N 281 0 R >>
/MaxLen 2
/AA << /Bl << /S /JavaScript /JS (var memorized_eventvalue=event.value;
  if\(app.viewerVersion<6\) event.rc = true;\r
if \(event.value != ""\) { 
   var success=0;

   var sollmenge=["G1","G2","G3","G4","G5"];
   var strSollMenge="";

   for\(var n in sollmenge\)
   {       if\(sollmenge[n]==event.value\)
           {    success=1; 
           }
           strSollMenge+=sollmenge[n]+"\\r";              
   }
           
   if\(0==success\)
   { 
     var meckerstring="Bitte geben Sie in dieses Feld einen der folgenden Werte ein:\\r"+strSollMenge;
     app.alert\(meckerstring\);
     event.rc = false;
   }       
}if(false==event.rc){    event.rc=true;      event.value=memorized_eventvalue;     app.beep(0);     event.target.setFocus();}) >>
 >>
>>
endobj
